# ==============================================================================
# SARPRAS KKP — Konfigurasi Lingkungan Docker & Database
# ==============================================================================

# Port Web Server Aplikasi SIM-SARPRAS KKP
# Akses aplikasi via browser di: http://localhost:8080
PORT=8080

# Port phpMyAdmin Database Manager (Opsional)
# Akses GUI database via browser di: http://localhost:8081
PMA_PORT=8081

# Port MySQL yang diekspos ke Host Komputer
# Default 3307 agar tidak bertabrakan jika Laragon/XAMPP aktif di port 3306
DB_EXTERNAL_PORT=3307

# Konfigurasi Koneksi Database Internal Container
DB_HOST=db
DB_PORT=3306
DB_NAME=kkp_sarpras_db
DB_USER=root
DB_PASS=rootpassword

# Eksekusi seeder otomatis saat container pertama kali dinyalakan (true / false)
AUTO_SEED=true
