<IfModule mod_dir.c>
    DirectoryIndex index.php index.html
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Kompatibilitas lama apabila ada request ke /backend/api/*
    RewriteRule ^backend/api/(.*)$ api/$1 [L,QSA]

    # Lewatkan file dan direktori fisik yang ada (assets/, api/, dll.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Fallback ke index.php
    RewriteRule ^ index.php [L]
</IfModule>
