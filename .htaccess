<IfModule mod_rewrite.c>
    Options -Indexes
    RewriteEngine On

    # Blokir akses langsung ke file & direktori sensitif Laravel jika DocumentRoot masih di root proyek
    RewriteRule ^(\.env.*|\.git|composer\.(json|lock)|package\.json|artisan|phpunit\.xml|Dockerfile|docker-compose\.yml|docker-entrypoint\.sh) - [F,L,NC]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/|$) - [F,L,NC]

    # Arahkan semua request lain ke folder public/ secara transparan
    RewriteCond %{REQUEST_URI} !^/public(/|$)
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
